{
  "name": "vela-desktop",
  "main": "worker/preview.mjs",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "MAIN",
      "service": "vela-cyd"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixl-chat",
      "database_id": "f4415581-ad3a-4d83-b62d-6cc2288d99f1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "UserHubV2",
        "script_name": "vela-cyd"
      },
      {
        "name": "LEGACY_HUB",
        "class_name": "UserHub",
        "script_name": "vela-cyd"
      },
      {
        "name": "ROOM",
        "class_name": "CallRoomV2",
        "script_name": "vela-cyd"
      },
      {
        "name": "LEGACY_ROOM",
        "class_name": "CallRoom",
        "script_name": "vela-cyd"
      },
      {
        "name": "ARCADE",
        "class_name": "ArcadeRoom"
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pixl-chat-files"
    }
  ],
  "migrations": [
    {
      "tag": "arcade-v1",
      "new_sqlite_classes": [
        "ArcadeRoom"
      ]
    }
  ]
}
